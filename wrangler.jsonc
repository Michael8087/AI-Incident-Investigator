{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-incident-investigator",
  "compatibility_date": "2026-09-03",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
